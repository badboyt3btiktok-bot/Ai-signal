[Unit]
Description=Agent City (autonomous agent company)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=agentcity
Group=agentcity
WorkingDirectory=/opt/agent-city
EnvironmentFile=/etc/agent-city.env
ExecStart=/opt/agent-city/.venv/bin/python agentcity.py serve --interval 10
Restart=always
RestartSec=15
# Hardening (the agents' code itself runs inside the Docker sandbox)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/agent-city/city_home /var/lib/agentcity

[Install]
WantedBy=multi-user.target
